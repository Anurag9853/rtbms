APP_NAME=RTBMS
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://rtbms-api.onrender.com

# ── Database (MongoDB Atlas) ───────────────────────────────────────────────
DB_CONNECTION=mongodb
DB_DSN=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/rtbms?retryWrites=true&w=majority
DB_DATABASE=rtbms

# ── Cache / Session ────────────────────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log

# ── Auth ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://rtbms.vercel.app
SANCTUM_STATEFUL_DOMAINS=rtbms.vercel.app

# ── Mail (optional — for forgot password emails) ───────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@rtbms.app
MAIL_FROM_NAME=RTBMS
