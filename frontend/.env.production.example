# ── Production environment variables for Vercel ──────────────────────────────
# Copy this to .env in your Vercel project dashboard (Settings → Environment Variables)
# or create a .env.production file locally for manual builds.

# Required: Your Render backend URL (no trailing slash)
VITE_API_URL=https://rtbms-api.onrender.com/api/v1

# Optional: Mapbox token for live map features
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Optional: Pusher for real-time features
VITE_PUSHER_APP_KEY=your_pusher_key
VITE_PUSHER_APP_CLUSTER=ap2

# App name shown in UI
VITE_APP_NAME=RTBMS
